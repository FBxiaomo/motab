{
    "name": "MoTab 新标签页",
    "description": "简约美观的浏览器起始页",
    "version": "1.0.1",
    "manifest_version": 3,
    "default_locale": "zh_CN",
    "icons": {
        "16": "icons/logo.png",
        "32": "icons/logo.png",
        "48": "icons/logo.png",
        "128": "icons/logo.png"
    },
    "action": {
        "default_popup": "popup-ext.html",
        "default_icon": {
            "16": "icons/action_logo.png",
            "32": "icons/action_logo.png",
            "128": "icons/action_logo.png"
        }
    },
    "chrome_url_overrides": {
        "newtab": "startpage.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": ["activeTab"],
    "host_permissions": [
        "https://favicon.im/*",
        "https://api.iowen.cn/*",
        "<all_urls>"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https://favicon.im https://api.iowen.cn data: blob: *"
    }
}
